generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



model ChargingStation {
  id               String        @id @default(uuid())
  name             String        @unique
  code             String        @unique
  chargePointsCount Int          @default(5)
  totalCapacity    String?       @default("120 kW")
  stationType      String?       @default("Public Fast Hub")
  mobilityType     String?       @default("Stationary")
  latitude         Float?        @default(19.0760)
  longitude        Float?        @default(72.8777)
  totalSessions    Int           @default(0)
  revenueGenerated Float         @default(0.0)
  energyDelivered  Float         @default(0.0)

  // Relational fields
  chargePoints     ChargePoint[]
  liveSessions     LiveSession[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Tariff {
  id            String        @id @default(uuid())
  name          String
  code          String        @unique
  type          String        @default("Default")
  status        String        @default("Active")
  baseRate      Float         @default(15.0)
  gstPercentage Float         @default(18.0)
  description   String?
  pricingConfig String?

  // Relational fields
  chargePoints  ChargePoint[]
  liveSessions  LiveSession[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ChargePoint {
  id                String          @id @default(uuid())
  name              String
  code              String          @unique
  manufacturer      String
  mode              String
  accessibility     String
  stage             String          @default("Active")
  exclusive         String          @default("Shared")
  gracePeriod       Int?
  tariffProfiles    String?
  settlementProfile String?
  type              String          @default("AC")
  chargingMethods   String          // Storing JSON array string

  // Extended fields
  cpId              String?
  thirdPartyCpId    String?         @default("NA")
  oem               String?         @default("EVRE")
  zone              String?         @default("-")
  lastActive        String?
  totalSessions     Int?            @default(0)
  energyDelivered   Float?          @default(0.0)
  revenueGenerated  Float?          @default(0.0)
  mobilityType      String?         @default("Stationary")
  qrCodeId          String?
  firmwareVersion   String?         @default("2.0.2")
  status            String?         @default("Available")
  totalCapacity     String?         @default("-")

  // Foreign Key Relationships
  chargingStationId String
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [id], onDelete: Cascade)

  tariffId          String?
  tariff            Tariff?         @relation(fields: [tariffId], references: [id])

  connectors        Connector[]
  liveSessions      LiveSession[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Connector {
  id            String      @id @default(uuid())
  connectorId   Int         @default(1)
  type          String      @default("Type2")
  maxPower      Float?      @default(22.0)
  status        String      @default("Available")

  // Foreign Key to ChargePoint
  chargePointId String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Cascade)

  liveSessions  LiveSession[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  initials     String
  color        String        @default("bg-indigo-100 text-indigo-700")

  liveSessions LiveSession[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LiveSession {
  id                String          @id @default(uuid())
  status            String          @default("Ongoing") // Ongoing, Completed, Failed, Stopped
  initialSoc        Float?          @default(10)
  currentSoc        Float?          @default(55)
  kwhDelivered      Float           @default(0.0)
  totalCost         Float           @default(0.0)
  chargeTxCode      String?
  billCode          String?

  billId            String?         @unique
  bill              Bill?           @relation(fields: [billId], references: [id])

  // Foreign Keys
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  chargingStationId String
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [id], onDelete: Cascade)

  chargePointId     String
  chargePoint       ChargePoint     @relation(fields: [chargePointId], references: [id], onDelete: Cascade)

  connectorId       String?
  connector         Connector?      @relation(fields: [connectorId], references: [id])

  tariffId          String?
  tariff            Tariff?         @relation(fields: [tariffId], references: [id])

  logs              SessionLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Bill {
  id                      String       @id @default(uuid())
  billNumber              String       @unique
  billStatus              String       @default("Unpaid") // Unpaid, Paid, Not Generated
  chargeTransactionStatus String       @default("Completed")

  chargeTransaction       String
  energyDelivered         String
  appliedDiscount         String?      @default("-")
  amount                  Float        @default(0.0)
  fleet                   String?      @default("-")
  method                  String?      @default("User Wallet")
  driverName              String?
  driverInitials          String?
  driverColor             String?
  invoiceAvailable        Boolean      @default(true)
  chargePoint             String?
  generatedOn             DateTime     @default(now())

  session                 LiveSession?

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}


model SessionLog {
  id            String      @id @default(uuid())
  command       String
  direction     String      @default("INBOUND") // INBOUND or OUTBOUND
  messageId     String?
  logType       String      @default("OCPP 1.6J")
  summary       String
  body          String      // JSON string representation

  sessionId     String
  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
}

model Fleet {
  id                     String   @id @default(uuid())
  name                   String   @unique
  operatorCode           String   @unique
  ownerName              String?
  ownerEmail             String?
  accessCodeUsage        String?  @default("Open To Everyone")
  paymentType            String?  @default("Prepaid")
  gstin                  String?
  companyName            String?
  companyEmail           String?
  companyPhone           String?
  driverCount            Int      @default(0)
  availableWalletBalance Float    @default(0.0)
  status                 String   @default("Active")
  contactEmail           String?
  contactPhone           String?
  address                String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Discount {
  id                    String    @id @default(uuid())
  name                  String    @unique
  code                  String?   @unique
  description           String?
  type                  String    @default("Percentage Discounts") // Percentage Discounts, Fixed Amount, Discounted Tariff Rates
  value                 Float     @default(0.0)
  status                String    @default("Active") // Active, Inactive, Expired
  expiresOn             DateTime?
  conditionType         String    @default("OR") // OR, AND
  appVariants           String    @default("All") // All, Selected
  userAccess            String    @default("All") // All, Selected
  selectedUsers         String?   @default("[]") // JSON array of selected users
  fleetsAccess          String    @default("All") // All, Selected
  selectedFleets        String?   @default("[]") // JSON array of selected fleets
  chargingStationsAccess String    @default("All") // All, Selected
  selectedStations      String?   @default("[]") // JSON array of selected stations
  chargePointsAccess    String    @default("All") // All, Selected
  selectedChargePoints  String?   @default("[]") // JSON array of selected charge points

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model TeamMember {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  userType   String    @default("Team Member")
  status     String    @default("Active")
  joinedAt   DateTime  @default(now())
  lastActive DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PaymentGatewayConfig {
  id                 String    @id @default(uuid())
  provider           String    @default("razorpay")
  environment        Int       @default(0) // 0 = Test, 1 = Live
  configured         Boolean   @default(false)
  active             Boolean   @default(false)
  displayName        String?   @default("")
  keyId              String?   @default("")
  keySecret          String?   @default("")
  webhookSecret      String?   @default("")
  webhookUrl         String?   @default("")
  currency           String    @default("INR")
  settlementCurrency String    @default("INR")
  description        String?   @default("")
  autoCapture        Boolean   @default(true)
  autoRefund         Boolean   @default(true)
  connectionStatus   String    @default("not_tested")
  lastTestedAt       DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([provider, environment])
}


